/proyecto/arranque-dual/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self'; style-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), screen-wake-lock=(self)

/proyecto/arranque-dual/fonts/*
  Cache-Control: public, max-age=31536000, immutable
